# Copy to .env.local and fill in. Firebase web config values are public
# client identifiers (they end up in the browser bundle), not secrets.
# Never add a password variable — the Planner password is only typed in the UI.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email of the single Planner account
VITE_PLANNER_EMAIL=
