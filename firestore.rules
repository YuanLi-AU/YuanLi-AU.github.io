rules_version = '2';

// Private Planner — only the owner's Firebase UID can read or write, and only
// under their own users/{uid}/... paths listed below.
// Any path not matched below is denied by default.
//
// This file is the source of truth, but it does NOT protect the live database
// until it is published (Firebase Console → Firestore → Rules → Publish).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == 'nT8r9eqsdaWGdAcLUhV68iUh9hf2'
        && request.auth.uid == userId;
    }

    // users/{uid}/dailyPlans/{YYYY-MM-DD} — active rows for one day
    match /users/{userId}/dailyPlans/{dateKey} {
      allow read, write: if isOwner(userId)
        && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // users/{uid}/plans/midTerm and users/{uid}/plans/longTerm
    match /users/{userId}/plans/{planId} {
      allow read, write: if isOwner(userId) && planId in ['midTerm', 'longTerm'];
    }

    // users/{uid}/completedHistory/{itemId} — completed rows.
    // delete is only used by Restore (in a transaction that puts the row back
    // into its active list); there is no plain "delete history" in the app.
    match /users/{userId}/completedHistory/{itemId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // users/{uid}/settings/planner — important date countdown
    match /users/{userId}/settings/{docId} {
      allow read, write: if isOwner(userId) && docId == 'planner';
    }
  }
}
